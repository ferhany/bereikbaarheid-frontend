{
  "name": "bereikbaarheid-frontend",
  "version": "3.2.0",
  "private": true,
  "engines": {
    "node": ">=18.19 <21",
    "npm": ">=9.6",
    "yarn": ">=1.22"
  },
  "volta": {
    "node": "20.19.5",
    "npm": "10.8.2",
    "yarn": "1.22.22"
  },
  "dependencies": {
    "@amsterdam/arm-core": "^1.0.0",
    "@amsterdam/arm-nontiled": "^1.0.0",
    "@amsterdam/asc-assets": "^0.38.0",
    "@amsterdam/asc-ui": "^0.38.0",
    "@amsterdam/react-maps": "^1.1.1",
    "@hookform/resolvers": "^5.2.2",
    "@microsoft/applicationinsights-react-js": "^19.3.8",
    "@microsoft/applicationinsights-web": "^3.3.11",
    "@piwikpro/react-piwik-pro": "^2.5.0",
    "@react-spring/web": "^10.0.3",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-devtools": "^5.91.3",
    "axios": "^1.13",
    "date-fns": "^4.1.0",
    "html-react-parser": "^5.2.17",
    "i18next": "^25.8.11",
    "i18next-browser-languagedetector": "^8.2.1",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "leaflet.nontiledlayer": "^1.0.9",
    "lodash": "^4.17.23",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-hook-form": "^7.71.1",
    "react-i18next": "^16.5.4",
    "react-router": "^7.13.0",
    "react-router-dom": "^7.13.0",
    "styled-components": "^6.3.10",
    "typescript": "^5.9.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/eslint": "^8",
    "@types/geojson": "^7946.0.16",
    "@types/jest": "^30.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/lodash": "^4.17.23",
    "@types/node": "^25.3.0",
    "@types/react-is": "^19",
    "@types/styled-components": "^5.1.36",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest-dom": "^5.5.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "http-proxy-middleware": "^3.0.5",
    "husky": "^9.1.7",
    "jest-canvas-mock": "^2.5.2",
    "jest-matchmedia-mock": "^1.1.0",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.2.7",
    "mq-polyfill": "^1.1.8",
    "msw": "^2.12.10",
    "prettier": "^3.8.1",
    "react-is": "^19.2.4",
    "vite": "^7.3.1",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "*",
    "@babel/plugin-transform-private-property-in-object": "*",
    "@testing-library/dom": "*"
  },
  "scripts": {
    "clean": "rm -Rf build node_modules .yarn .eslintcache",
    "prepare": "husky install",
    "start": "BROWSER=none GENERATE_SOURCEMAP=false vite",
    "build": "GENERATE_SOURCEMAP=false vite build",
    "lint": "eslint --cache .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "eslintConfig": {
    "parser": "@typescript-eslint/parser",
    "extends": [
      "eslint:recommended",
      "plugin:jest-dom/recommended",
      "plugin:jsx-a11y/recommended",
      "plugin:prettier/recommended"
    ],
    "overrides": [
      {
        "files": [
          "**/*.test.*"
        ],
        "env": {
          "jest": true,
          "commonjs": true
        }
      }
    ],
    "plugins": [
      "import",
      "jest-dom",
      "jsx-a11y",
      "prettier",
      "react",
      "react-hooks",
      "@typescript-eslint"
    ],
    "rules": {
      "import/first": "error",
      "import/newline-after-import": "error",
      "import/no-duplicates": "error",
      "import/no-unused-modules": "error",
      "import/order": [
        "error",
        {
          "alphabetize": {
            "order": "asc",
            "caseInsensitive": true
          },
          "newlines-between": "always",
          "groups": [
            "builtin",
            "external",
            "internal",
            "parent",
            "sibling",
            "index",
            "object"
          ],
          "pathGroups": [
            {
              "pattern": "react",
              "group": "builtin",
              "position": "before"
            }
          ],
          "pathGroupsExcludedImportTypes": [
            "builtin"
          ],
          "warnOnUnassignedImports": true
        }
      ],
      "nonblock-statement-body-position": "error"
    }
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "npm run lint",
      "npm run test:staged"
    ]
  },
  "prettier": {
    "arrowParens": "avoid",
    "semi": false,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "printWidth": 120
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
